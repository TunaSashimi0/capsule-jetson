ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    YOLO_CONFIG_DIR=/tmp/ultralytics \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-tools \
    libglib2.0-0 \
    libgl1 \
    python3-opencv \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Jetson PyTorch wheels are tightly coupled to JetPack/L4T. Keep the CUDA-enabled
# torch packages from the NVIDIA base image and install the app stack around them.
RUN python3 - <<'PY' > /tmp/jetson-torch-constraints.txt
import importlib.metadata as metadata

required = ("torch", "torchvision")
missing = []
for package in required:
    try:
        print(f"{package}=={metadata.version(package)}")
    except metadata.PackageNotFoundError:
        missing.append(package)

if missing:
    raise SystemExit(
        "The Jetson base image must include NVIDIA's CUDA-enabled PyTorch and torchvision. "
        "Use an nvcr.io/nvidia/l4t-pytorch image matching this device's L4T release."
    )
PY

RUN python3 -m pip install --upgrade pip setuptools wheel && \
    python3 -m pip install -r requirements.txt -c /tmp/jetson-torch-constraints.txt && \
    python3 -m pip uninstall -y opencv-python opencv-python-headless

COPY src ./src
COPY configs ./configs
COPY models/trained ./models/trained
COPY README.md .

RUN mkdir -p /app/models/base /app/models/trained /app/runs /app/data/samples

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/stats', timeout=2).read()"

CMD ["uvicorn", "src.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
