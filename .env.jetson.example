# Copy this file to .env.jetson and adjust values for the target Jetson.

# Use an NVIDIA l4t-pytorch image that matches /etc/nv_tegra_release.
# This device currently reports R36 REVISION 5.0, so choose a matching R36.5 tag
# from NVIDIA NGC when available for your JetPack/L4T release.
JETSON_BASE_IMAGE=REPLACE_WITH_MATCHING_L4T_PYTORCH_TAG

# Point this at your trained OBB model when it exists.
CAPSULE_MODEL=/app/models/trained/capsule_yolo11s_obb_best.pt

# Dual native-resolution IMX219-AF sources. Leave the secondary source blank for
# single-camera operation.
CAPSULE_SOURCE=csi:0
CAPSULE_SECONDARY_SOURCE=csi:1

# Use 0/cuda:0 for GPU, or cpu for CPU-only troubleshooting.
CAPSULE_DEVICE=0
CAPSULE_IMGSZ=1280
CAPSULE_EXPOSURE_US=8000
CAPSULE_ANALOG_GAIN=1.0
CAPSULE_DIGITAL_GAIN=1.0
CAPSULE_HALF=true
CAPSULE_CONF=0.25
CAPSULE_IOU=0.7
CAPSULE_CAPTURE_WIDTH=3280
CAPSULE_CAPTURE_HEIGHT=2464
CAPSULE_CAPTURE_FPS=21
# Browser-only, on-demand preview. These do not change YOLO input quality.
CAPSULE_PREVIEW_WIDTH=1280
CAPSULE_PREVIEW_FPS=2
CAPSULE_PREVIEW_JPEG_QUALITY=84
CAPSULE_AUTOFOCUS=true

# OCEANMES server connection. Provision the device in OCEANMES and copy the
# one-time edge key into the untracked .env.jetson file.
OCEANMES_ENABLED=false
OCEANMES_BASE_URL=https://oceanmes.com
OCEANMES_EDGE_API_KEY=
OCEANMES_CONNECT_TIMEOUT_SECONDS=3
OCEANMES_READ_TIMEOUT_SECONDS=30
OCEANMES_VERIFY_TLS=true
OCEANMES_CA_BUNDLE=
# Keep false in production. Enable only for an isolated HTTP LAN test.
OCEANMES_ALLOW_HTTP=false
CAPSULE_EDGE_SOFTWARE_VERSION=capsule-jetson-dev

# MCP23017/MCP23008 solenoid sequence. Keep disabled until the driver-board
# polarity is verified: a wrong ACTIVE_HIGH value can energize a valve at rest.
CAPSULE_SOLENOID_ENABLED=false
CAPSULE_SOLENOID_CHIP=mcp23017
CAPSULE_SOLENOID_I2C_BUS=7
CAPSULE_SOLENOID_I2C_ADDRESS=0x20
CAPSULE_SOLENOID_ACTIVE_HIGH=true
CAPSULE_SOLENOID_INTAKE_CHANNEL=0
CAPSULE_SOLENOID_DISCHARGE_CHANNEL=1
CAPSULE_SOLENOID_INTAKE_SECONDS=2
CAPSULE_SOLENOID_INSPECTION_SECONDS=30
CAPSULE_SOLENOID_DISCHARGE_SECONDS=3
CAPSULE_SOLENOID_COOLDOWN_SECONDS=120
