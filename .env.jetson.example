# Copy this file to .env.jetson and adjust values for the target Jetson.

# Use an NVIDIA l4t-pytorch image that matches /etc/nv_tegra_release.
# This device currently reports R39 REVISION 2.0, so choose the matching R39.2 tag
# from NVIDIA NGC when available for your JetPack/L4T release.
JETSON_BASE_IMAGE=REPLACE_WITH_MATCHING_L4T_PYTORCH_TAG

# Point this at your trained OBB model when it exists.
CAPSULE_MODEL=/app/models/trained/capsule_yolo11s_obb_best.pt

# Use csi:0 for Jetson CSI cam0, 0 for /dev/video0, or a video file under /app/data.
CAPSULE_SOURCE=csi:0
CAPSULE_CAMERA_DEVICE=/dev/video0

# Use 0/cuda:0 for GPU, or cpu for CPU-only troubleshooting.
CAPSULE_DEVICE=0
CAPSULE_IMGSZ=1280
CAPSULE_CAPTURE_WIDTH=1920
CAPSULE_CAPTURE_HEIGHT=1080
CAPSULE_CAPTURE_FPS=30
CAPSULE_JPEG_QUALITY=95
CAPSULE_EXPOSURE_US=8000
CAPSULE_ANALOG_GAIN=1.0
CAPSULE_DIGITAL_GAIN=1.0
CAPSULE_HALF=true
CAPSULE_CONF=0.25
CAPSULE_IOU=0.7
